# Создано https://www.toptal.com/developers/gitignore/api/python,linux
# Редактировать в https://www.toptal.com/developers/gitignore?templates=python,linux

### Linux ###
*~

# временные файлы, которые могут быть созданы, если у процесса все еще открыт дескриптор удаленного файла
.fuse_hidden*

# Настройки каталога KDE
.каталог

# Папка корзины Linux, которая может появиться на любом разделе или диске
.Trash-*

# Файлы .nfs создаются, когда открытый файл удаляется, но к нему по-прежнему осуществляется доступ
.nfs*

